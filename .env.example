# Copy to .env and fill in. Read by the bot (python-dotenv) and docker compose.

# Local Telegram Bot API server (docker-compose), from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# S3-compatible storage. Defaults target the RustFS container in docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Also used as the RustFS root credentials - change before exposing port 9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET_IPA=ipa
S3_BUCKET_PLIST=plist

# Public base URLs for uploaded files (key is appended). iOS installs need HTTPS,
# e.g. https://files.example.com/ipa behind a reverse proxy to port 9000.
# Defaults to <S3_ENDPOINT>/<bucket> when unset.
S3_PUBLIC_URL_IPA=
S3_PUBLIC_URL_PLIST=

